{
  "name": "unity-codemode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code Mode runtime for the ProjetoAction Unity Editor: one code tool over the Unity Pipeline CLI.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "unity-codemode": "./run.mjs"
  },
  "scripts": {
    "describe": "node run.mjs --describe",
    "search": "node run.mjs --search",
    "status": "node run.mjs --code \"return unity.status()\""
  }
}
